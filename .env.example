# Optional public origin used by the configurator's cached live preview.
# Omit it when the preview API is served on the same origin.
VITE_NBB_PUBLIC_URL=https://stats-generator.example.nl

# The exported embed script is expected to be hosted by Basketballstats.
VITE_NBB_WIDGET_SCRIPT_URL=https://www.basketballstats.nl/db/json/nbb-stats-widget.js

# Identifies this installation in requests made by the server-side NBB-Stats client.
NBB_CONTACT=https://example.nl/contact

# Persistent shared cache. Mount this directory as a volume in production.
NBB_CACHE_FILE=.data/nbb-stats.sqlite

# The NBB-Stats client never starts upstream requests closer than this.
NBB_UPSTREAM_INTERVAL_MS=15000

# Optional comma-separated origin allowlist. Empty means public browser origins are reflected.
NBB_ALLOWED_ORIGINS=

HOST=0.0.0.0
PORT=4173
