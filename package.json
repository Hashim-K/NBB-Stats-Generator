{
  "name": "nbb-stats-generator",
  "version": "0.1.0",
  "private": true,
  "description": "A safe visual generator for cached, copy-and-paste NBB games and standings widgets.",
  "author": "Hashim K",
  "license": "MIT",
  "homepage": "https://github.com/Hashim-K/NBB-Stats-Generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hashim-K/NBB-Stats-Generator.git"
  },
  "bugs": {
    "url": "https://github.com/Hashim-K/NBB-Stats-Generator/issues"
  },
  "keywords": [
    "basketball",
    "basketball-nederland",
    "basketballstats",
    "embed",
    "nbb",
    "widget"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.widget.config.ts && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "nbb-stats": "0.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^20.11.2",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
